{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://backend.example.com/api/:path*"
        },
        {
            "source": "/(sanctum/csrf-cookie|login|logout|register|email/verification-notification|forgot-password|reset-password|up|verify-email)",
            "destination": "https://backend.example.com/$1"
        }
    ],
    "headers": [
        {
            "source": "/(api/:path*|sanctum/csrf-cookie|login|logout|register|email/verification-notification|forgot-password|reset-password|up|verify-email)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Credentials",
                    "value": "true"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "https://miriam.informaticamajada.es"
                },
                {
                    "key": "Access-Control-Allow-Methods",
                    "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version"
                }
            ]
        }
    ]
}